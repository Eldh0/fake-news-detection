# Copy this file to .streamlit/secrets.toml for LOCAL testing, or enter the
# same values in Streamlit Community Cloud under Settings -> Secrets.
#
# The app first looks for a local saved_model/ folder. If that folder is not
# present, it loads the model from the Hugging Face Hub using MODEL_REPO_ID.
#
# Use a PUBLIC model repository if possible. If the repository is private,
# also set HF_TOKEN and keep it secret.

# Public fine-tuned model (no training required):
# MODEL_REPO_ID = "therealcyberlord/fake-news-classification-distilbert"

# Or your own fine-tuned model:
# MODEL_REPO_ID = "your-huggingface-username/fake-news-distilbert"

# Only needed for a private model repository:
# HF_TOKEN = "hf_your_token_here"
